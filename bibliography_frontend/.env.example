# API Configuration
# All requests route through API Gateway (port 3000) for centralized auth, logging, and routing
# For direct service access (testing only), override with service URLs:
#   Bibliography Service: http://localhost:8005/api/bibliography
#   Auth Service: http://localhost:8001/api/auth
VITE_API_BASE_URL=http://localhost:3000/api/bibliography
VITE_AUTH_SERVICE_URL=http://localhost:3000/api/auth

# Environment
VITE_NODE_ENV=development
