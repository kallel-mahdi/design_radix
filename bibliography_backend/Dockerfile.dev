# Development Dockerfile for Bibliography Backend
# Adapted from editor_backend pattern with hot reload support

FROM node:22-alpine

# Install curl for health checks
RUN apk add --no-cache curl

WORKDIR /app

# Copy package files first (layer caching optimization)
COPY package*.json ./

# Install ALL dependencies (including dev dependencies for ts-node-dev)
RUN npm install

# Copy TypeScript config
COPY tsconfig.json ./

# Copy source code (will be overridden by bind mount in docker-compose)
COPY src ./src

# Create logs directory
RUN mkdir -p logs

# Expose backend port
EXPOSE 8005

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8005/health || exit 1

# Use ts-node-dev for hot reload in development
CMD ["npm", "run", "dev"]
