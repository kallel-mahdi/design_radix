# Server Configuration
PORT=8005
NODE_ENV=development

# Database
# For local development (MongoDB installed on host):
MONGODB_URL=mongodb://localhost:27017/bibliography
# For Docker development (use container service name):
# MONGODB_URL=mongodb://mongodb:27017/bibliography_dev

# File Storage
UPLOAD_PATH=./data/uploads

# External APIs
# Crossref API Configuration
CROSSREF_API_URL=https://api.crossref.org
# For testing with mock server:
# CROSSREF_API_URL=http://localhost:3001/mock-crossref

# Logging
LOG_LEVEL=info

# CORS
FRONTEND_URL=http://localhost:5173

# Trust Gateway Auth (from API Gateway)
TRUST_GATEWAY_AUTH=true
